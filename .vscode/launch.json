{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "Local\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser"
      }
    },
    {
      "name": "dev (LAN)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host"
    },
    {
      "name": "build",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run build"
    },
    {
      "name": "preview",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run preview",
      "serverReadyAction": {
        "pattern": "Local\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openIntegratedBrowser"
      }
    }
  ]
}
