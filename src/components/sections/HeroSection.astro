---
import LogoGraph from '../hero-visuals/LogoGraph.astro';
---

<section class="tile hero" style="--i:0">
  <div class="hero-copy">
    <h1>Fractal Manifold</h1>
    <p class="tagline">Mathematical Deep Learning Research</p>
  </div>
  <LogoGraph />
</section>

<style>
  .hero {
    grid-column: span 8;
    grid-row: span 2;
    min-height: 520px;
    justify-content: space-between;
    padding: 2.5rem;
    background:
      radial-gradient(ellipse at 80% 70%, rgba(147, 51, 234, 0.14), transparent 60%),
      radial-gradient(ellipse at 20% 20%, rgba(245, 158, 11, 0.08), transparent 55%),
      rgba(12, 12, 14, 0.95);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  /* Original site typography: Bruno Ace title, system-font tagline */
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 1.1;
    letter-spacing: 2px;
    max-width: 9ch;
  }

  .tagline {
    margin-top: 1.25rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    font-size: 1.15rem;
    color: var(--color-text-secondary);
  }


  @media (max-width: 1080px) {
    .hero {
      grid-column: span 6;
      grid-row: auto;
    }
  }

  @media (max-width: 760px) {
    .hero {
      min-height: 460px;
      padding: 1.75rem;
    }
  }
</style>
