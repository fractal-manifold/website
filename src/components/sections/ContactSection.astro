---
---

<section id="contact" class="tile contact" style="--i:12">
  <div class="contact-copy">
    <span class="label">04 — Contact</span>
    <h2>Contact</h2>
    <p>Have an innovative startup or research idea? We'd love to hear about your project.</p>
  </div>
  <a class="email" href="mailto:contact@fractalmanifold.com">contact@fractalmanifold.com</a>
</section>

<style>
  .contact {
    grid-column: span 12;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem;
  }

  .contact-copy {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 46ch;
  }

  .email {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1rem, 2.4vw, 1.9rem);
    color: var(--color-gold-light);
    padding: 1.1rem 1.75rem;
    border: 1px solid rgba(245, 158, 11, 0.4);
    border-radius: 14px;
    overflow-wrap: anywhere;
    transition: background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  @media (hover: hover) {
    .email:hover {
      background: var(--color-gold);
      color: #070708;
      box-shadow: 0 20px 60px -20px rgba(245, 158, 11, 0.5);
    }
  }

  @media (max-width: 1080px) {
    .contact {
      grid-column: span 6;
    }
  }

  @media (max-width: 760px) {
    .contact {
      flex-direction: column;
      align-items: stretch;
      padding: 1.75rem;
    }

    .email {
      text-align: center;
      font-size: 3.6vw;
      padding: 1rem 0.75rem;
    }
  }
</style>
