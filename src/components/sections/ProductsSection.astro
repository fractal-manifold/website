---
import ProductTile from '../ProductTile.astro';

// Announced but not launched: no link, so they stay visually quieter than the product tiles.
const upcoming: { title: string; label?: string; text?: string }[] = [
  {
    title: 'Detailed Art',
    label: 'AI Imaging',
    text: 'Every image, more possibilities. Imagine, transform and create with AI — a space to take your images a little further.',
  },
  {
    title: 'Xenagora',
    label: 'Agent Network',
    text: 'A network for AI agents: register, discover peers and ask questions across fleets or inside your firewall — routed to the best answerer by expertise.',
  },
];
---

<div class="bento-group">
  <section id="products" class="tile products-head" style="--i:10">
    <span class="label">03 — Products</span>
    <h2>Products</h2>
    <p>Tools and research that come out of the lab — each built on the same mathematical foundations.</p>
  </section>

  <ProductTile
    href="https://tokenmonitor.dev"
    label="Hardware · LAN"
    title="Token Monitor"
    tags={['ESP32-S3', 'LVGL', 'LAN-only']}
    accent="purple"
    index={11}
    span={7}
  >
    Live Claude Code, Codex &amp; Gemini usage on a 4&Prime; wall display — session windows, limits and alerts, all on your LAN, no cloud.
  </ProductTile>

  {upcoming.map((item, idx) => (
    <article class="tile soon" style={`--i:${12 + idx}`}>
      <div class="soon-top">
        {item.label && <span class="label">{item.label}</span>}
        <span class="soon-badge">Coming soon</span>
      </div>
      <h3>{item.title}</h3>
      {item.text && <p>{item.text}</p>}
    </article>
  ))}
</div>

<style>
  .products-head {
    grid-column: span 5;
    justify-content: flex-end;
  }

  .soon {
    grid-column: span 6;
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(14, 14, 16, 0.72);
  }

  .soon-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .soon .label {
    color: var(--color-text-muted);
  }

  .soon-badge {
    margin-left: auto;
    font-family: var(--display);
    font-size: 0.625rem;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: var(--color-text-secondary);
  }

  .tile.soon h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 1080px) {
    .products-head {
      grid-column: span 6;
    }

    .soon {
      grid-column: span 3;
    }
  }
</style>
