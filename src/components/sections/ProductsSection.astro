<style>
  .products-head {
    justify-content: flex-end;
  }

  /* Each product gets its own brand color so the two stand out from the neutral tiles. */
  .product {
    min-height: 280px;
    text-decoration: none;
    color: inherit;
    border-color: rgba(245, 158, 11, 0.55);
    background:
      radial-gradient(ellipse at 100% 0%, rgba(245, 158, 11, 0.16), transparent 60%),
      rgba(14, 14, 16, 0.92);
    box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.1), 0 20px 60px -30px rgba(245, 158, 11, 0.35);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .product--purple {
    border-color: rgba(168, 85, 247, 0.6);
    background:
      radial-gradient(ellipse at 100% 0%, rgba(147, 51, 234, 0.2), transparent 60%),
      rgba(14, 14, 16, 0.92);
    box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.1), 0 20px 60px -30px rgba(147, 51, 234, 0.4);
  }

  .tile.product h3 {
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .product p {
    flex: 1;
  }

  .product--purple .label {
    color: var(--color-purple-light);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    color: var(--color-text-secondary);
  }

  .product-cta {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-gold-light);
    transition: transform 0.3s ease;
  }

  .product--purple .product-cta {
    color: var(--color-purple-light);
  }

  @media (hover: hover) {
    .product:hover {
      border-color: var(--color-gold);
      box-shadow: 0 0 0 1px rgba(245, 158, 11, 0.25), 0 20px 60px -20px rgba(245, 158, 11, 0.5);
      transform: translateY(-3px);
    }

    .product--purple:hover {
      border-color: var(--color-purple-light);
      box-shadow: 0 0 0 1px rgba(168, 85, 247, 0.25), 0 20px 60px -20px rgba(147, 51, 234, 0.55);
    }

    .product:hover .product-cta {
      transform: translateX(4px);
    }
  }

  @media (max-width: 1080px) {
    .products-head {
      grid-column: span 6;
    }

    .product {
      grid-column: span 3;
    }
  }

  @media (max-width: 760px) {
    .product {
      min-height: 0;
    }
  }
</style>
