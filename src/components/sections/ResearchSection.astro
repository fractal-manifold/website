const features = [
  {
    title: 'Advanced Deep Learning',
    text: 'Developing next-generation neural architectures',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 1v3M15 1v3M9 20v3M15 20v3M1 9h3M1 15h3M20 9h3M20 15h3" />',
  },
  {
    title: 'Fundamental Research',
    text: 'Exploring the theoretical foundations of artificial intelligence',
    icon: '<circle cx="12" cy="12" r="1" /><path d="M20.2 20.2c2.04-2.03.02-7.36-4.5-11.9-4.54-4.52-9.87-6.54-11.9-4.5-2.04 2.03-.02 7.36 4.5 11.9 4.54 4.52 9.87 6.54 11.9 4.5z" /><path d="M15.7 15.7c4.52-4.54 6.54-9.87 4.5-11.9-2.03-2.04-7.36-.02-11.9 4.5-4.52 4.54-6.54 9.87-4.5 11.9 2.03 2.04 7.36.02 11.9-4.5z" />',
  },
  {
    title: 'Practical Applications',
    text: 'Transferring research insights into real-world solutions',
    icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />',
  },
