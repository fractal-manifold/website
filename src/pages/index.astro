---
import '@fontsource/unbounded/400.css';
import '@fontsource/unbounded/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '../styles/bento.css';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ResearchSection from '../components/sections/ResearchSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import FoundersSection from '../components/sections/FoundersSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
---

<Layout title="Fractal Manifold - Deep Learning Research & Investment">
  <Header />

  <main id="main-content" class="bento">
    <HeroSection />
    <ResearchSection />
    <ProductsSection />
    <FoundersSection />
    <ContactSection />
  </main>

  <Footer />
</Layout>
